{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../@shared/*"],
      "background/*": ["src/background/*"],
      "contentScript/*": ["src/contentScript/*"],
      "popup/*": ["src/popup/*"],
      "constants/*": ["src/constants/*"],
      "helpers/*": ["src/helpers/*"]
    },
    "types": [
      "@types/chrome",
      "@types/jest",
      "node",
      "jest",
      "@testing-library/jest-dom"
    ]
  },
  "include": ["src", "public"],
  "exclude": ["build"]
}

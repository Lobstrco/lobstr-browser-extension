{
    "name": "@lobstrco/signer-extension-api",
    "version": "3.0.0",
    "license": "Apache-2.0",
    "author": "Ultra Stellar, LLC.",
    "description": "Utility functions to interact with LOBSTR extension",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Lobstrco/lobstr-browser-extension.git"
    },
    "homepage": "https://github.com/Lobstrco/lobstr-browser-extension#readme",
    "bugs": {
        "url": "https://github.com/Lobstrco/lobstr-browser-extension/issues"
    },
    "main": "build/index.cjs",
    "module": "build/index.mjs",
    "types": "build/index.d.ts",
    "typesVersions": {
        "*": {
            "protocol": [
                "build/protocol/index.d.ts"
            ]
        }
    },
    "unpkg": "build/index.min.js",
    "jsdelivr": "build/index.min.js",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.mjs",
            "require": "./build/index.cjs",
            "default": "./build/index.min.js"
        },
        "./protocol": {
            "types": "./build/protocol/index.d.ts",
            "import": "./build/protocol.mjs",
            "require": "./build/protocol.cjs",
            "default": "./build/protocol.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "build/index.min.js",
        "build/index.cjs",
        "build/index.mjs",
        "build/protocol.cjs",
        "build/protocol.mjs",
        "build/**/*.d.ts",
        "README.md",
        "CHANGELOG.MD",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "browserslist": [
        "last 3 chrome versions",
        "last 3 firefox versions"
    ],
    "scripts": {
        "build": "rm -rf build && webpack --config webpack.production.js --mode production && tsc -p tsconfig.json --emitDeclarationOnly",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint --ext .ts,.js .",
        "lint:fix": "eslint --fix --ext .ts,.js .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pretest": "npm run build",
        "test": "jest",
        "pretest:ci": "npm run build",
        "test:ci": "jest --ci",
        "verify:types": "bash scripts/verify-published-types.sh",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-typescript": "^7.27.1",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "babel-jest": "^29.7.0",
        "babel-loader": "^9.2.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^2.8.8",
        "typescript": "~5.1.6",
        "webpack": "^5.88.0",
        "webpack-cli": "^5.1.4",
        "webpack-merge": "^5.9.0"
    },
    "overrides": {
        "chalk": "4.1.2",
        "strip-ansi": "6.0.1",
        "color-convert": "2.0.1",
        "color-name": "1.1.4",
        "error-ex": "1.3.2",
        "has-ansi": "5.0.1",
        "is-core-module": "2.13.1"
    }
}

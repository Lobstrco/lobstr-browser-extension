{
    "name": "@lobstrco/signer-extension-api",
    "version": "3.0.0-rc.1",
    "license": "Apache-2.0",
    "author": "Ultra Stellar, LLC.",
    "description": "Utility functions to interact with LOBSTR extension",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Lobstrco/signer-extension-api.git"
    },
    "homepage": "https://github.com/Lobstrco/signer-extension-api#readme",
    "bugs": {
        "url": "https://github.com/Lobstrco/signer-extension-api/issues"
    },
    "main": "build/index.cjs",
    "module": "build/index.mjs",
    "types": "build/index.d.ts",
    "typesVersions": {
        "*": {
            "protocol": [
                "build/protocol/index.d.ts"
            ]
        }
    },
    "unpkg": "build/index.min.js",
    "jsdelivr": "build/index.min.js",
    "exports": {
        ".": {
            "import": {
                "types": "./build/index.d.mts",
                "default": "./build/index.mjs"
            },
            "require": {
                "types": "./build/index.d.ts",
                "default": "./build/index.cjs"
            },
            "default": "./build/index.cjs"
        },
        "./protocol": {
            "import": {
                "types": "./build/protocol/index.d.mts",
                "default": "./build/protocol.mjs"
            },
            "require": {
                "types": "./build/protocol/index.d.ts",
                "default": "./build/protocol.cjs"
            },
            "default": "./build/protocol.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "build/index.min.js",
        "build/index.cjs",
        "build/index.mjs",
        "build/protocol.cjs",
        "build/protocol.mjs",
        "build/**/*.d.ts",
        "build/**/*.d.mts",
        "README.md",
        "CHANGELOG.MD",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pretest": "npm run build",
        "test": "vitest run",
        "pretest:watch": "npm run build",
        "test:watch": "vitest",
        "verify:types": "bash scripts/verify-published-types.sh",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    },
    "overrides": {
        "chalk": "4.1.2",
        "strip-ansi": "6.0.1",
        "color-convert": "2.0.1",
        "color-name": "1.1.4",
        "error-ex": "1.3.2",
        "has-ansi": "5.0.1",
        "is-core-module": "2.13.1"
    }
}
